---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<meta name="generator" content={Astro.generator} />
		<title>Coming Soon :)</title>
	</head>
	<body class="custom-pattern">
		<!-- Desktop View (hidden on mobile) -->
		<div class="hidden md:flex flex-row flex-wrap justify-center items-center h-screen gap-8 px-4">
			<div>
				<img src="https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExbWhsbXVrNG9zejIwOGtvZnBib3B2OTlhcGE2aWpmamFmd2l1bDE5eSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9cw/IQebREsGFRXmo/giphy.gif" alt="Mew Gif" class="gif cursor-pointer hover:scale-105 transition-transform duration-200" id="github-gif-desktop"/>
			</div>
			<div class="text-center px-6 py-4 bg-black bg-opacity-20 rounded-lg backdrop-blur-sm mx-4 my-6">
				<h1 class="bricolage-grotesque text-white text-4xl font-extrabold mb-4">Coming Soon ...</h1>
				<div class="space-y-3">
					<p class="space-grotesk text-white text-lg">
						This website is currently under construction.
						<br>We're putting the finishing touches on something special.
					</p>
					<p class="space-grotesk text-white text-lg">
						You're going to love what's coming, I promise.
					</p>
				</div>
			</div>
		</div>

		<!-- Mobile View (hidden on desktop) -->
		<div class="md:hidden flex flex-col justify-center items-center h-screen px-4 py-8 transition-all duration-300">
			<div class="mb-8 animate-fade-in">
				<img src="https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExbWhsbXVrNG9zejIwOGtvZnBib3B2OTlhcGE2aWpmamFmd2l1bDE5eSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9cw/IQebREsGFRXmo/giphy.gif" alt="Mew Gif" class="gif cursor-pointer hover:scale-105 transition-transform duration-200" id="github-gif-mobile"/>
			</div>
			<div class="text-center max-w-md mx-auto animate-slide-up p-6 bg-black bg-opacity-20 rounded-xl backdrop-blur-sm border border-white border-opacity-10 mt-4 mb-8">
				<h1 class="bricolage-grotesque text-white text-3xl font-extrabold mb-6 leading-tight">Coming Soon ...</h1>
				<div class="space-y-4">
					<p class="space-grotesk text-white text-base leading-relaxed">
						This website is currently under construction.
					</p>
					<p class="space-grotesk text-white text-base leading-relaxed">
						We're putting the finishing touches on something special.
					</p>
					<p class="space-grotesk text-white text-base leading-relaxed">
						You're going to love what's coming, I promise.
					</p>
				</div>
			</div>
		</div>

		<script>
			// Handle both desktop and mobile GIF clicks
			const handleGifClick = (element: HTMLElement | null) => {
				if (element) {
					element.addEventListener('click', () => {
						window.location.href = 'https://github.com/WyliGr';
					});
					
					// Add tap effect for mobile
					element.addEventListener('touchstart', () => {
						element.style.transform = 'scale(0.95)';
					});
					
					element.addEventListener('touchend', () => {
						element.style.transform = 'scale(1)';
					});
				}
			};

			// Apply to both elements
			handleGifClick(document.getElementById('github-gif-desktop'));
			handleGifClick(document.getElementById('github-gif-mobile'));
		</script>
	</body>
</html>